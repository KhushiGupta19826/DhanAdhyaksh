# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── CORS ───────────────────────────────────────────────────────────────────────
# Set to your Vercel frontend URL in production
CORS_ORIGIN=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dhanadhyaksh?schema=public"

# ── Test database (used only during `npm test`) ────────────────────────────────
TEST_DATABASE_URL="postgresql://user:password@host:5432/dhanadhyaksh_test?schema=public"

# ── Authentication ─────────────────────────────────────────────────────────────
# Your login email
AUTH_EMAIL=owner@example.com

# bcrypt hash of your password — generate with:
#   node -e "require('bcryptjs').hash('YourPassword', 12).then(console.log)"
AUTH_PASSWORD_HASH=$2b$12$REPLACE_WITH_YOUR_BCRYPT_HASH

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_64_char_random_hex_string

# How long a login session lasts (e.g. 7d, 24h, 30d)
JWT_EXPIRES_IN=7d
